<%- include ('partials/header') %>
<div class="timer-card">
    <h2>⏱️ O tempo acabou!</h2>
    <p>Você acabou de cronometrar: <strong><%= tempTimer.minutos %> min e <%= tempTimer.segundos %> seg</strong></p>

    <form action="/salvar-timer/confirmar" method="POST" class="form-container" style="margin-top: 1.5rem;">
        <div class="form-group">
            <label for="nome">Escolha um nome para salvar este cronômetro:</label>
            <input type="text" id="nome" name="nome" placeholder="EX: Macarrão, Ovos..." required>
        </div>

        <div class="controls" style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">Salvar nos Salvos</button>
            <a href="/" class="btn btn-danger">Não Salvar</a>
        </div>
    </form>
</div>

<%- include('partials/footer') %>