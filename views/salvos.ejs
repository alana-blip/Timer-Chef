<%- include('partials/header') %>

<h2>Cronômetros Salvos</h2>

<div class="grid-timers">
    <% if (timers.length === 0) { %>
        <p>Nenhum Cronômetro salvo até o momento. <a href="/">Criar um novo</a>.</p>
    <% } else { %>
     <% timers.forEach(timer => { %>
      <div class="card-salvo">
        <h3><%=timer.nome %></h3>
        <p class="tempo">⏱️<%= String(timer.minutos).padStart(2, '0') %>:<%= String(timer.segundos).padStart(2,'0') %></p>

        <div class="card-actions">
            <a href="/?min=<%= timer.minutos %>&seg=<%= timer.segundos %>&nome=<%=encodeURIComponent(timer.nome) %>" class="btn btn-success" title="Usar Novamente">
                ▶️ Usar
            </a>

            <button class="btn btn-warning" onclick="toggleEdit('<%=timer._id%>')">
                ✏️ Editar
            </button>

            <form action="/salvos/deletar/<%= timer._id %>" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Deseja realmente apagar este cronômetro?')">
                    🗑️ Apagar
                </button>
            </form>
        </div>

        <div class="edit-panel" id="edit-panel-<%= timer._id %>" style="display: none;">
            <form action="/salvos/editar/<%= timer._id %>" method="POST" class="form-container">
                <div class="form-group">
                    <label>Novo Nome:</label>
                    <input type="text" name="nome" value="<%= timer.nome %>" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Minutos:</label>
                        <input type="number" name="minutos" value="<%= timer.minutos %>" min="0" required>
                    </div>

                    <div class="form-group">
                        <label>Segundos:</label>
                        <input type="number" name="segundos" value="<%= timer.segundos %>" min="0" max="59" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem">Salvar Alterações</button>
            </form>
        </div>
      </div>
        <% }); %>
       <% } %>
</div>

    <script>
    function tooggleEdit(id) {
        const panel = document.getElementById(`edit-panel-${id}`);
        panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    }
    </script>

<%- include('partials/footer') %>

