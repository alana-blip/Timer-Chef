<%- include('partials/header') %>

<main>
  <div class="egg-timer-wrapper">
    <h2 id="timer-title"><%= timerAtivo.nome %></h2>

    <div class="egg-timer-body">
      <div class="egg-yolk-top"></div>

      <div class="timer-display" id="timer-display">00:00</div>

      <div class="timer-inputs">
        <input type="number" id="input-min" placeholder="Min" min="0" max="180" value="<%= timerAtivo.minutos %>">
        <span class="colon">:</span>
        <input type="number" id="input-seg" placeholder="Seg" min="0" max="59" value="<%= timerAtivo.segundos %>">
      </div>
    </div>

    <div class="timer-actions">
      <button id="btn-start" class="btn btn-start">Iniciar</button>
      <button id="btn-pause" class="btn btn-pause" disabled>Pausar</button>
      <button id="btn-reset" class="btn btn-reset">Resetar</button>
    </div>
  </div>
</main>

<form id="from-finalizar" action="/finalizar-timer" method="POST" style="display:none;">
    <input type="hidden" name="minutos" id="final-min">
    <input type="hidden" name="segundos" id="final-seg">
</form>

<script src="/javascripts/timer.js"></script>

<%- include('partials/footer') %>